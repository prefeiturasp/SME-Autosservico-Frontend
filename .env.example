# NextAuth Configuration
NEXTAUTH_URL=
NEXTAUTH_SECRET=

#AUTENTICA CORESSO (HOMOLOGAÇÃO)
AUTENTICA_CORESSO_API_TOKEN=
AUTENTICA_CORESSO_API_URL=

# Sistema que o usuário precisa ter acesso
NEXT_PUBLIC_SISTEMA_AUTOSERVICO=

# Versão da autenticação (v1 ou v2)
# v1 Autentica CORESSO
# v2 Autentica Keycloak
NEXT_PUBLIC_AUTH_VERSION=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_GRANT_TYPE=
KEYCLOAK_REALM=
KEYCLOAK_URL=

# Client id do Keycloak que representa a aplicação (resource_access.<client>.roles no
# access_token), usado para identificar o perfil de acesso do usuário. Muda por
# ambiente (ex: auto-servico-qa, auto-servico-hom, auto-servico-prod). Não confundir
# com KEYCLOAK_CLIENT_ID, que é o client usado para autenticar (ex: AUTOSSERVICO).
# Quando ausente, assume auto-servico-hom.
KEYCLOAK_RESOURCE_CLIENT_ID=



# Squads válidas para acesso (separadas por vírgula)
NEXT_PUBLIC_SQUADS_VALIDAS=

# Configuração para desenvolvimento
AUTH_TRUST_HOST=

ZABBIX_API_URL=
ZABBIX_API_TOKEN=
ZABBIX_DEFAULT_HOST=

# Azure DevOps Backlog
AZURE_DEVOPS_API_URL=
AZURE_DEVOPS_PAT=

# SonarQube
SONAR_URL=
SONAR_TOKEN=

# Jenkins
JENKINS_URL=
JENKINS_USERNAME=
JENKINS_API_TOKEN=
JENKINS_TIMEOUT_MS=
